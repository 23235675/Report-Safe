{
  "name": "report-safe",
  "version": "1.0.0",
  "private": true,
  "description": "Report Safe (報平安) — a resilient disaster-status reporting system.",
  "workspaces": [
    "server",
    "web",
    "mobile"
  ],
  "scripts": {
    "start": "node server/src/index.js",
    "dev:server": "cd server && node src/index.js",
    "dev:web": "cd web && npx vite",
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "build:web": "cd web && npx vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:memdb": "node scripts/test-with-memory-db.mjs",
    "check:shared": "node scripts/check-shared-drift.mjs",
    "db:up": "cd server && npm run db:up",
    "db:down": "cd server && npm run db:down",
    "db:reset": "cd server && npm run db:reset"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^9.39.4",
    "mongodb-memory-server": "^11.2.0",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^17.7.0",
    "typescript-eslint": "^8.62.0",
    "vite": "8.0.16",
    "vitest": "^4.1.9"
  }
}
